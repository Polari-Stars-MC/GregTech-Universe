{
  "multipart": [
    {
      "when": { "facing": "north" },
      "apply": { "model": "gtu_modpacks:block/machine/water_dam_controller" }
    },
    {
      "when": { "facing": "east" },
      "apply": { "model": "gtu_modpacks:block/machine/water_dam_controller", "y": 90 }
    },
    {
      "when": { "facing": "south" },
      "apply": { "model": "gtu_modpacks:block/machine/water_dam_controller", "y": 180 }
    },
    {
      "when": { "facing": "west" },
      "apply": { "model": "gtu_modpacks:block/machine/water_dam_controller", "y": 270 }
    }
  ]
}
